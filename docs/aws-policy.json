{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Read",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages", "ec2:DescribeInstances", "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeAvailabilityZones",
        "rds:DescribeDBInstances", "rds:DescribeDBSubnetGroups",
        "elasticache:DescribeReplicationGroups", "elasticache:DescribeCacheEngineVersions",
        "elasticache:DescribeCacheSubnetGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageLookup",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*::parameter/aws/service/*"
    },
    {
      "Sid": "Create",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances", "ec2:CreateSecurityGroup",
        "rds:CreateDBInstance", "rds:AddTagsToResource",
        "elasticache:CreateReplicationGroup", "elasticache:AddTagsToResource"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "TagOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {"StringEquals": {"ec2:CreateAction": ["RunInstances", "CreateSecurityGroup"]}}
    },
    {
      "Sid": "ChangeOwnResourcesOnly",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:ResourceTag/nepho-managed": "true"}}
    },
    {
      "Sid": "DeleteOwnServicesOnly",
      "Effect": "Allow",
      "Action": ["rds:DeleteDBInstance", "elasticache:DeleteReplicationGroup"],
      "Resource": [
        "arn:aws:rds:us-east-1:*:db:s-*",
        "arn:aws:elasticache:us-east-1:*:replicationgroup:s-*",
        "arn:aws:elasticache:us-east-1:*:cluster:s-*"
      ]
    },
    {
      "Sid": "ServicePasswords",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:AddTagsToResource", "ssm:GetParametersByPath", "ssm:DeleteParameter"],
      "Resource": [
        "arn:aws:ssm:us-east-1:*:parameter/nepho",
        "arn:aws:ssm:us-east-1:*:parameter/nepho/*"
      ]
    },
    {
      "Sid": "FirstUseOfRdsAndElastiCache",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {"StringEquals": {"iam:AWSServiceName": ["rds.amazonaws.com", "elasticache.amazonaws.com"]}}
    }
  ]
}
